diff --git a/device/dualsense/vaderhaptics_capability_test.go b/device/dualsense/vaderhaptics_capability_test.go
new file mode 100644
--- /dev/null
+++ b/device/dualsense/vaderhaptics_capability_test.go
@@ -0,0 +1,17 @@
+package dualsense
+
+import "testing"
+
+func TestVaderHapticsInputCapabilities(t *testing.T) {
+	dev, err := New(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	args := dev.GetDeviceSpecificArgs()
+	if args["vaderhapticsInputRevision"] != 1 {
+		t.Fatalf("missing input revision: %v", args)
+	}
+	if args["inputQueueCapacity"] != 8 || cap(dev.inputCh) != 8 {
+		t.Fatalf("input queue must have capacity 8: metadata=%v actual=%d", args["inputQueueCapacity"], cap(dev.inputCh))
+	}
+}
