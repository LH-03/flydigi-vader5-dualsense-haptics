diff --git a/device/dualsense/input_queue_test.go b/device/dualsense/input_queue_test.go
new file mode 100644
index 0000000..c18567a
--- /dev/null
+++ b/device/dualsense/input_queue_test.go
@@ -0,0 +1,214 @@
+package dualsense
+
+import (
+	"sync"
+	"testing"
+	"time"
+)
+
+func newQueueTestDevice(t *testing.T) *DualSense {
+	t.Helper()
+	dev, err := New(nil)
+	if err != nil {
+		t.Fatalf("New: %v", err)
+	}
+	drainInput(dev)
+	return dev
+}
+
+func drainInput(dev *DualSense) []InputState {
+	var states []InputState
+	for {
+		select {
+		case state := <-dev.inputCh:
+			states = append(states, state)
+		default:
+			return states
+		}
+	}
+}
+
+func assertNeutral(t *testing.T, state InputState) {
+	t.Helper()
+	if state != *NewInputState() {
+		t.Fatalf("state is not neutral: %+v", state)
+	}
+}
+
+func crossInputState() *InputState {
+	state := NewInputState()
+	state.Buttons = ButtonCross
+	return state
+}
+
+func leftStickInputState() *InputState {
+	state := NewInputState()
+	state.LY = 91
+	return state
+}
+
+func TestInputQueuePreservesPressReleaseBurst(t *testing.T) {
+	dev := newQueueTestDevice(t)
+	dev.UpdateInputState(crossInputState())
+	dev.UpdateInputState(NewInputState())
+	states := drainInput(dev)
+	if len(states) != 2 || states[0].Buttons != ButtonCross {
+		t.Fatalf("press/release order lost: %+v", states)
+	}
+	assertNeutral(t, states[1])
+}
+
+func TestInputQueuePreservesStickActiveNeutralBurst(t *testing.T) {
+	dev := newQueueTestDevice(t)
+	active := leftStickInputState()
+	dev.UpdateInputState(active)
+	dev.UpdateInputState(NewInputState())
+	states := drainInput(dev)
+	if len(states) != 2 || states[0].LY != active.LY {
+		t.Fatalf("stick active/neutral order lost: %+v", states)
+	}
+	assertNeutral(t, states[1])
+}
+
+func TestInputQueueDrainsShortBurstInExactOrder(t *testing.T) {
+	dev := newQueueTestDevice(t)
+	for value := int8(1); value <= 5; value++ {
+		state := NewInputState()
+		state.LY = value
+		dev.UpdateInputState(state)
+	}
+	states := drainInput(dev)
+	if len(states) != 5 {
+		t.Fatalf("drained %d states, want 5", len(states))
+	}
+	for index, state := range states {
+		if state.LY != int8(index+1) {
+			t.Fatalf("state %d LY=%d, want %d", index, state.LY, index+1)
+		}
+	}
+}
+
+func TestInputQueueOverflowRetainsNewestOrderedTail(t *testing.T) {
+	dev := newQueueTestDevice(t)
+	const published = inputQueueCapacity + 4
+	for value := 0; value < published; value++ {
+		state := NewInputState()
+		state.LY = int8(value)
+		dev.UpdateInputState(state)
+	}
+	states := drainInput(dev)
+	if len(states) != inputQueueCapacity {
+		t.Fatalf("retained %d states, want %d", len(states), inputQueueCapacity)
+	}
+	for index, state := range states {
+		want := int8(published - inputQueueCapacity + index)
+		if state.LY != want {
+			t.Fatalf("retained state %d LY=%d, want %d", index, state.LY, want)
+		}
+	}
+	telemetry := dev.InputQueueTelemetry()
+	if telemetry.OverflowDropped != 4 || telemetry.HighWater != inputQueueCapacity {
+		t.Fatalf("overflow telemetry=%+v", telemetry)
+	}
+}
+
+func TestInputQueueSteadyStateServicingHasNoOverflow(t *testing.T) {
+	dev := newQueueTestDevice(t)
+	for value := 0; value < 128; value++ {
+		state := NewInputState()
+		state.LY = int8(value)
+		dev.UpdateInputState(state)
+		states := drainInput(dev)
+		if len(states) != 1 || states[0].LY != int8(value) {
+			t.Fatalf("service %d delivered %+v", value, states)
+		}
+	}
+	telemetry := dev.InputQueueTelemetry()
+	if telemetry.OverflowDropped != 0 || len(dev.inputCh) != 0 || telemetry.HighWater > 1 {
+		t.Fatalf("steady state telemetry=%+v depth=%d", telemetry, len(dev.inputCh))
+	}
+}
+
+func TestInputQueueAudioAndMicrophoneResetsPreserveTransitions(t *testing.T) {
+	for _, endpoint := range []uint8{EndpointHapticsAudioOut, EndpointMicrophoneIn} {
+		t.Run("endpoint", func(t *testing.T) {
+			dev := newQueueTestDevice(t)
+			dev.UpdateInputState(crossInputState())
+			dev.UpdateInputState(NewInputState())
+			dev.ResetEndpoint(endpoint)
+			states := drainInput(dev)
+			if len(states) != 2 || states[0].Buttons != ButtonCross {
+				t.Fatalf("endpoint %#x erased transition: %+v", endpoint, states)
+			}
+			assertNeutral(t, states[1])
+		})
+	}
+}
+
+func TestInputQueueGamepadResetRepublishesLatestExactlyOnce(t *testing.T) {
+	dev := newQueueTestDevice(t)
+	dev.UpdateInputState(NewInputState())
+	latest := crossInputState()
+	latest.LY = 37
+	dev.UpdateInputState(latest)
+	dev.ResetEndpoint(EndpointIn)
+	states := drainInput(dev)
+	if len(states) != 1 || states[0] != *latest {
+		t.Fatalf("gamepad reset queued %+v, want exactly latest %+v", states, *latest)
+	}
+}
+
+func TestResetInputStateForStreamEndNeutralizesCrossAndStick(t *testing.T) {
+	for _, active := range []struct {
+		name  string
+		state *InputState
+	}{
+		{"cross", crossInputState()},
+		{"ly", leftStickInputState()},
+	} {
+		t.Run(active.name, func(t *testing.T) {
+			dev := newQueueTestDevice(t)
+			dev.UpdateInputState(active.state)
+			dev.ResetInputStateForStreamEnd()
+			dev.mtx.Lock()
+			latest := dev.inputState
+			dev.mtx.Unlock()
+			assertNeutral(t, latest)
+			states := drainInput(dev)
+			if len(states) != 1 {
+				t.Fatalf("stream end queued %d states", len(states))
+			}
+			assertNeutral(t, states[0])
+		})
+	}
+}
+
+func TestInputQueueConcurrentPublishersRemainNonBlocking(t *testing.T) {
+	dev := newQueueTestDevice(t)
+	var publishers sync.WaitGroup
+	for publisher := 0; publisher < 4; publisher++ {
+		publishers.Add(1)
+		go func(offset int) {
+			defer publishers.Done()
+			for value := 0; value < 128; value++ {
+				state := NewInputState()
+				state.LY = int8(offset + value)
+				dev.UpdateInputState(state)
+			}
+		}(publisher)
+	}
+	done := make(chan struct{})
+	go func() {
+		publishers.Wait()
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("concurrent publishers blocked")
+	}
+	telemetry := dev.InputQueueTelemetry()
+	if len(dev.inputCh) > inputQueueCapacity || telemetry.HighWater > inputQueueCapacity {
+		t.Fatalf("bounded queue violated: depth=%d telemetry=%+v", len(dev.inputCh), telemetry)
+	}
+}

