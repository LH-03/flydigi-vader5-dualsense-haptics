+func TestReadDualSenseV5InputStreamEndNeutralizesActiveInput(t *testing.T) {
+	for _, active := range []struct {
+		name  string
+		state *InputState
+	}{
+		{"cross", crossInputState()},
+		{"ly", leftStickInputState()},
+	} {
+		t.Run(active.name, func(t *testing.T) {
+			dev, client, errCh := newV5ReaderTest(t)
+			payload, _ := active.state.MarshalBinary()
