+func (d *DualSense) ResetInputQueueToLatest() {
+	d.inputPublishMu.Lock()
+	defer d.inputPublishMu.Unlock()
+	d.mtx.Lock()
+	latest := d.inputState
+	d.mtx.Unlock()
+	d.resetInputQueueLocked(latest)
+}
+
+func (d *DualSense) ResetInputStateForStreamEnd() {
+	d.inputPublishMu.Lock()
+	defer d.inputPublishMu.Unlock()
+	neutral := *NewInputState()
+	d.mtx.Lock()
+	d.inputState = neutral
+	d.mtx.Unlock()
+	d.resetInputQueueLocked(neutral)
+}
+
+func (d *DualSense) resetInputQueueLocked(state InputState) {
+	for {
+		select {
+		case <-d.inputCh:
+		default:
+			goto drained
+		}
+	}
+
+drained:
+	d.inputCh <- state
+	d.inputQueueEnqueued++
+	if len(d.inputCh) > d.inputQueueHighWater {
+		d.inputQueueHighWater = len(d.inputCh)
+	}
 }
 
